nextflow_process {

    name "Test Process DADA2"
    script "modules/local/dada2/main.nf"
    process "DADA2"
    tag "modules"
    tag "dada2"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ 
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_1.fastq.gz', checkIfExists: true),
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_2.fastq.gz', checkIfExists: true) 
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.dada2_out).match("dada2_out") },
                { assert snapshot(process.out.dada2_stats).match("dada2_stats") }
            )
        }
    }

    test("Should run in gap mode (justConcatenate)") {

        when {
            params {
                outdir           = "$outputDir"
                dada2_merge_mode = "gap"
            }
            process {
                """
                input[0] = [
                    [ id:'test_gap', single_end:false ], // meta map
                    [
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_1.fastq.gz', checkIfExists: true),
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.dada2_out).match("dada2_out_gap") },
                { assert snapshot(process.out.dada2_stats).match("dada2_stats_gap") }
            )
        }
    }

    test("Should run in separate mode") {

        when {
            params {
                outdir           = "$outputDir"
                dada2_merge_mode = "separate"
            }
            process {
                """
                input[0] = [
                    [ id:'test_separate', single_end:false ], // meta map
                    [
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_1.fastq.gz', checkIfExists: true),
                        file('${projectDir}/modules/local/dada2/tests/data/test_noambig_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.dada2_out).match("dada2_out_separate") },
                { assert snapshot(process.out.dada2_stats).match("dada2_stats_separate") }
            )
        }
    }
}
