nextflow_process {

    name "Test Process ITS_SANITY_CHECKER"
    script "../main.nf"
    process "ITS_SANITY_CHECKER"
    tag "modules"
    tag "its_sanity_checker"

    test("its_sanity_checker successful test") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def itsone_fp = file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_ITS_ITSoneDB.mseq', checkIfExists: true)
                def unite_fp = file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_ITS_UNITE.mseq', checkIfExists: true)

                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        'ITSone': itsone_fp.readLines().size(),
                        'UNITE': unite_fp.readLines().size(),
                        'Rfam_SSU_LSU': file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_ITS_rRNA.fa', checkIfExists: true).readLines().findAll { it.startsWith('>') }.size(),
                        'ITSone_fp': itsone_fp,
                        'UNITE_fp': unite_fp,
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.its_sanity_check_out, process.out.its_sanity_check_out_mqc).match() }
            )
        }

    }

    test("its_sanity_checker unsuccessful test") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                def itsone_fp = file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_NOTITS_ITSoneDB.mseq', checkIfExists: true)
                def unite_fp = file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_NOTITS_UNITE.mseq', checkIfExists: true)

                input[0] = [
                    [ id:'test', single_end:false ],
                    [
                        'ITSone': itsone_fp.readLines().size(),
                        'UNITE': unite_fp.readLines().size(),
                        'Rfam_SSU_LSU': file('${projectDir}/modules/local/its_sanity_checker/tests/data/test_NOTITS_rRNA.fa', checkIfExists: true).readLines().findAll { it.startsWith('>') }.size(),
                        'ITSone_fp': itsone_fp,
                        'UNITE_fp': unite_fp,
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.its_sanity_check_out, process.out.its_sanity_check_out_mqc).match() }
            )
        }

    }

}
