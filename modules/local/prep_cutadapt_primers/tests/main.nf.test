nextflow_process {

    name "Test Process PREP_CUTADAPT_PRIMERS"
    script "../main.nf"
    process "PREP_CUTADAPT_PRIMERS"
    tag "modules"
    tag "prep_cutadapt_primers"

    test("primers - fasta") {

        when {
            params {
                bases_allowed_before_primer = 10
            }
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/test_provided_forward.fasta", checkIfExists: true),
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/test_provided_reverse.fasta", checkIfExists: true)
               ]
                """
            }
        }

        then {
            def (_meta, f, r, f_rc, r_rc) = process.out.cutadapt_prepared_primers[0]
            assertAll(
                { assert process.success },
                { assert path(f).readLines()[1]    == "XN{10}GTGYCAGCMGCCGCGGTAA" },
                { assert path(r).readLines()[1]    == "XN{10}GGACTACNVGGGTWTCTAAT" },
                { assert path(f_rc).readLines()[1] == "TTACCGCGGCKGCTGRCACN{10}X" },
                { assert path(r_rc).readLines()[1] == "ATTAGAWACCCBNGTAGTCCN{10}X" },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("primers - empty reverse") {

        when {
            params {
                bases_allowed_before_primer = 10
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/test_provided_forward.fasta", checkIfExists: true),
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/empty.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def (_meta, f, r, f_rc, r_rc) = process.out.cutadapt_prepared_primers[0]
            assertAll(
                { assert process.success },
                { assert path(f).size() > 0 && path(f_rc).size() > 0 },
                { assert path(r).size() == 0 && path(r_rc).size() == 0 }
            )
        }
    }

    test("primers - stub") {

        options "-stub"

        when {
            params {
                bases_allowed_before_primer = 10
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/test_provided_forward.fasta", checkIfExists: true),
                    file("${projectDir}/modules/local/prep_cutadapt_primers/tests/data/test_provided_reverse.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
