nextflow_process {

    name "Test Process CUTADAPT"
    script "../main.nf"
    process "CUTADAPT"
    config "./nextflow.config"

    tag "modules"
    tag "cutadapt"

    // Reads come from assets/test-fixtures/test-reads/make_readthrough_reads.py; primer
    // files are 515F/806R as PREP_CUTADAPT_PRIMERS writes them (bases_allowed_before_primer = 25):
    // 16S V4 (515F/806R) pairs whose 292 bp amplicon (253 bp without primers) is
    // labelled by class in each read header. After trimming, both primers must be
    // gone from every read: classes through/edge/partial end at 253 nt; long and
    // internal reads (150 nt, no read-through) lose only their 5' primer.

    test("cutadapt - PE - primers trimmed from both read ends") {

        when {
            process {
                """
                input[0] = [
                    [ id:'readthrough', single_end:false ],
                    [
                        file("${moduleDir}/tests/data/readthrough_1.fastq.gz", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_2.fastq.gz", checkIfExists: true)
                    ],
                    [
                        file("${moduleDir}/tests/data/readthrough_F.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_R.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_F_RC.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_R_RC.fasta", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            // [class: [R1 length, R2 length]] expected after trimming
            def expected = [
                through: [253, 253], edge: [253, 253], partial: [253, 253],
                long: [131, 130], internal: [131, 130]
            ]
            // 5' primer of each mate, then the other primer reverse-complemented (3' read-through)
            def primers = [
                [~/^GTG[CT]CAGC[AC]GCCGCGGTAA/, ~/ATTAGA[AT]ACCC[CGT].GTAGTCC/],
                [~/^GGACTAC.[ACG]GGGT[AT]TCTAAT/, ~/TTACCGCGGC[GT]GCTG[AG]CAC/]
            ]
            def problems = []
            process.out.reads[0][1].eachWithIndex { fastq, mate ->
                path(fastq.toString()).linesGzip.collate(4).each { rec ->
                    def cls = (rec[0] =~ /class=(\w+)/)[0][1]
                    def seq = rec[1]
                    def name = "R${mate + 1} ${rec[0].tokenize(' ')[0]} (${cls})"
                    if (seq =~ primers[mate][0]) problems << "${name}: 5' primer left"
                    if (seq.length() > 30 && seq[-30..-1] =~ primers[mate][1]) problems << "${name}: 3' RC primer left"
                    if (seq.length() != expected[cls][mate]) problems << "${name}: length ${seq.length()}, expected ${expected[cls][mate]}"
                }
            }
            assertAll(
                { assert process.success },
                { assert problems.isEmpty() : "${problems.size()} problems:\n" + problems.join('\n') }
            )
        }

    }

    test("cutadapt - SE - primers trimmed from both read ends") {

        when {
            process {
                """
                input[0] = [
                    [ id:'readthrough_se', single_end:true ],
                    file("${moduleDir}/tests/data/readthrough_se.fastq.gz", checkIfExists: true),
                    [
                        file("${moduleDir}/tests/data/readthrough_F.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_R.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_F_RC.fasta", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_R_RC.fasta", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            def expected = [through: 253, edge: 253, partial: 253, long: 131, internal: 131]
            def problems = []
            path(process.out.reads[0][1].toString()).linesGzip.collate(4).each { rec ->
                def cls = (rec[0] =~ /class=(\w+)/)[0][1]
                def seq = rec[1]
                def name = "${rec[0].tokenize(' ')[0]} (${cls})"
                if (seq =~ /^GTG[CT]CAGC[AC]GCCGCGGTAA/) problems << "${name}: 5' primer left"
                if (seq.length() > 30 && seq[-30..-1] =~ /ATTAGA[AT]ACCC[CGT].GTAGTCC/) problems << "${name}: 3' RC primer left"
                if (seq.length() != expected[cls]) problems << "${name}: length ${seq.length()}, expected ${expected[cls]}"
            }
            assertAll(
                { assert process.success },
                { assert problems.isEmpty() : "${problems.size()} problems:\n" + problems.join('\n') }
            )
        }

    }

    test("cutadapt - PE - no primers gives empty placeholder outputs") {

        when {
            process {
                """
                input[0] = [
                    [ id:'readthrough', single_end:false ],
                    [
                        file("${moduleDir}/tests/data/readthrough_1.fastq.gz", checkIfExists: true),
                        file("${moduleDir}/tests/data/readthrough_2.fastq.gz", checkIfExists: true)
                    ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reads[0][1].every { path(it.toString()).toFile().size() == 0 } }
            )
        }

    }

}
