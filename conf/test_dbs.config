
/*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
     Config to store the paths/labels to the different reference databases
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    mapseq_databases {
        silva_ssu {
            fasta = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-SSU/SILVA-SSU_small.fasta"
            tax = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-SSU/SILVA-SSU_small-tax.txt"
            otu = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-SSU/SILVA-SSU_small.otu"
            mscluster = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-SSU/SILVA-SSU_small.fasta.mscluster"
            label = "SILVA-SSU"  // SSU
            run_otu = true
            run_asv = true
            dada2_label = "DADA2-SILVA"
        }
        silva_lsu {
            fasta = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-LSU/SILVA-LSU_small.fasta"
            tax = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-LSU/SILVA-LSU_small-tax.txt"
            otu = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-LSU/SILVA-LSU_small.otu"
            mscluster = "${projectDir}/assets/test-fixtures/test-ref-dbs/SILVA-LSU/SILVA-LSU_small.fasta.mscluster"
            label = "SILVA-LSU"  // LSU
            run_otu = true
            run_asv = true
            dada2 = false
        }
        pr2 {
            fasta = "${projectDir}/assets/test-fixtures/test-ref-dbs/PR2/PR2_small.fasta"
            tax = "${projectDir}/assets/test-fixtures/test-ref-dbs/PR2/PR2_small-tax.txt"
            otu = "${projectDir}/assets/test-fixtures/test-ref-dbs/PR2/PR2_small.otu"
            mscluster = "${projectDir}/assets/test-fixtures/test-ref-dbs/PR2/PR2_small.fasta.mscluster"
            label = "PR2"
            run_otu = true
            run_asv = true
            dada2_label = "DADA2-PR2"
        }
        itsone {
            fasta = "${projectDir}/assets/test-fixtures/test-ref-dbs/ITSone/ITSone_small.fasta"
            tax = "${projectDir}/assets/test-fixtures/test-ref-dbs/ITSone/ITSone_small-tax.txt"
            otu = "${projectDir}/assets/test-fixtures/test-ref-dbs/ITSone/ITSone_small.otu"
            mscluster = "${projectDir}/assets/test-fixtures/test-ref-dbs/ITSone/ITSone_small.fasta.mscluster"
            label = "ITSone"  // ITSonedb
            run_otu = true
            run_asv = false
        }
        unite {
            fasta = "${projectDir}/assets/test-fixtures/test-ref-dbs/UNITE/UNITE_small.fasta"
            tax = "${projectDir}/assets/test-fixtures/test-ref-dbs/UNITE/UNITE_small-tax.txt"
            otu = "${projectDir}/assets/test-fixtures/test-ref-dbs/UNITE/UNITE_small.otu"
            mscluster = "${projectDir}/assets/test-fixtures/test-ref-dbs/UNITE/UNITE_small.fasta.mscluster"
            label = "UNITE"
            run_otu = true
            run_asv = false
        }
    }

    // rfam
    rrnas_rfam_covariance_model = "${projectDir}/assets/test-fixtures/test-ref-dbs/RFAM"
    rrnas_rfam_claninfo = "${projectDir}/assets/test-fixtures/test-ref-dbs/RFAM/ribo.clan_info"

    // Standard primer library
    std_primer_library = ""

}

