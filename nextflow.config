                'maintainer',
            ],
            orcid: 'https://orcid.org/0000-0002-4853-4189',
        ],
        [
            name: 'Martin Beracochea',
            affiliation: 'EMBL-EBI',
            github: '@mberacochea',
            contribution: [
                'contributor',
                'maintainer',
            ],
            orcid: 'https://orcid.org/0000-0003-3472-3736',
        ],
        [
            name: 'Germana Baldi',
            affiliation: 'EMBL-EBI',
            github: '@Ge94',
            contribution: [
                'contributor',
                'maintainer',
            ],
            orcid: 'https://orcid.org/0000-0003-1719-5206',
        ],
        [
            name: 'Sandy Rogers',
            affiliation: 'EMBL-EBI',
            github: '@SandyRogers',
            contribution: [
                'contributor'
            ],
            orcid: 'https://orcid.org/0000-0002-4283-6135',
        ],
        [
            name: 'Ekaterina Sakharova',
            affiliation: 'EMBL-EBI',
            github: '@KateSakharova',
            contribution: [
                'contributor',
            ],
            orcid: 'https://orcid.org/0000-0001-6867-2039',
        ],
        [
            name: 'Varsha Kale',
            affiliation: 'EMBL-EBI',
            github: '@Vkale1',
            contribution: [
                'contributor'
            ],
            orcid: 'https://orcid.org/0000-0002-3503-6383',
        ],
        [
            name: 'Jennifer Lu',
            affiliation: 'EMBL-EBI',
            github: 'ebi-jlu8',
            contribution: [
                'contributor'
            ],
            orcid: 'https://orcid.org/0000-0002-1777-4788',
        ],
        [
            name: 'Timothy Rozday',
            affiliation: 'EMBL-EBI',
            github: '@timrozday-mgnify',
            contribution: [
                'contributor'
            ],
            orcid: 'https://orcid.org/0000-0001-7016-0665',
        ],
    ]
    homePage        = 'https://github.com/EBI-Metagenomics/amplicon-analysis-pipeline'
    description     = """MGnify's amplicon analysis pipeline performs taxonomic annotation of amplicon sequencing data using both closed-reference and amplicon sequence variant methods."""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=23.04.0'
    version         = '6.0.6'
    doi             = '10.1093/nar/gkac1080'
}
